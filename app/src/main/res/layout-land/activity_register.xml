<?xml version="1.0" encoding="utf-8"?>
<!-- Đăng ký - màn hình ngang: cột trái là nút quay lại + tiêu đề, cột phải là form (cuộn riêng).
     Giữ nguyên id + loại view như bản dọc để RegisterActivity dùng chung. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Cột trái: quay lại, tiêu đề, chuyển sang đăng nhập -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/iv_register_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:contentDescription="Quay lại"
            app:tint="@color/colorTextPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Header Logo Container (ẩn như bản dọc) -->
        <FrameLayout
            android:id="@+id/reg_logo_container"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_story_ring"
            app:layout_constraintTop_toBottomOf="@id/iv_register_back"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_music_note"
                android:padding="12dp"
                app:tint="@color/colorNeonPink" />
        </FrameLayout>

        <!-- Screen Titles: căn giữa khoảng trống giữa nút quay lại và chân trang -->
        <TextView
            android:id="@+id/tv_reg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="Tạo tài khoản"
            android:textColor="@color/colorTextPrimary"
            android:textSize="26sp"
            android:letterSpacing="-0.02"
            android:textStyle="bold"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@id/iv_register_back"
            app:layout_constraintBottom_toTopOf="@id/tv_reg_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_reg_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="Chọn ảnh đại diện và điền vài thông tin để bắt đầu."
            android:textColor="@color/colorTextSecondary"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tv_reg_title"
            app:layout_constraintBottom_toTopOf="@id/layout_to_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- To Login Footer -->
        <LinearLayout
            android:id="@+id/layout_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? "
                android:textColor="@color/colorTextSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Cột phải: form đăng ký (chỉ cột này cuộn) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Form Card Container -->
        <LinearLayout
            android:id="@+id/layout_register_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar Selection Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ảnh đại diện"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Avatar Options Row -->
            <LinearLayout
                android:id="@+id/layout_avatar_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="-6dp"
                android:layout_marginBottom="8dp">

                <!-- Avatar 0: Neon Purple (Accent) -->
                <FrameLayout
                    android:id="@+id/avatar_opt_0"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:padding="2.5dp"
                    android:background="@drawable/bg_story_ring"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:src="@drawable/ic_person"
                        android:padding="10dp"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <!-- Avatar 1: Neon Cyan -->
                <FrameLayout
                    android:id="@+id/avatar_opt_1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:padding="2.5dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:src="@drawable/ic_person"
                        android:padding="10dp"
                        app:tint="@color/colorNeonCyan" />
                </FrameLayout>

                <!-- Avatar 2: Neon Pink -->
                <FrameLayout
                    android:id="@+id/avatar_opt_2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:padding="2.5dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:src="@drawable/ic_person"
                        android:padding="10dp"
                        app:tint="@color/colorNeonPink" />
                </FrameLayout>

                <!-- Avatar 3: Neon Orange -->
                <FrameLayout
                    android:id="@+id/avatar_opt_3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:padding="2.5dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:src="@drawable/ic_person"
                        android:padding="10dp"
                        app:tint="@color/colorNeonOrange" />
                </FrameLayout>

                <!-- Avatar 4: Primary Electric Blue -->
                <FrameLayout
                    android:id="@+id/avatar_opt_4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:padding="2.5dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:src="@drawable/ic_person"
                        android:padding="10dp"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Field 1: Họ và tên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và tên"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_reg_fullname"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:hint="Ví dụ: Nguyễn Văn A"
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:drawableTint="@color/colorTextMuted"
                android:imeOptions="flagNoExtractUi"
                android:singleLine="true" />

            <!-- Field 2: Tên đăng nhập -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên đăng nhập"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_reg_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:hint="Chữ thường, không dấu, không khoảng trắng"
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="12dp"
                android:drawableTint="@color/colorTextMuted"
                android:imeOptions="flagNoExtractUi"
                android:singleLine="true" />

            <!-- Field 3: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_reg_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:hint="ban@email.com"
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/ic_mail"
                android:drawablePadding="12dp"
                android:drawableTint="@color/colorTextMuted"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <!-- Field 4 + 5: Mật khẩu và Nhập lại mật khẩu đặt cạnh nhau cho đỡ phải cuộn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mật khẩu"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_reg_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_login_input"
                        android:hint="Tối thiểu 6 ký tự"
                        android:textColorHint="@color/colorInputHint"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/colorTextMuted"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhập lại mật khẩu"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_reg_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_login_input"
                        android:hint="Nhập lại mật khẩu"
                        android:textColorHint="@color/colorInputHint"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/colorTextMuted"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Submit Registration Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_register_submit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Tạo tài khoản"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_gradient_button" />

            <!-- Đăng ký nhanh bằng tài khoản Google (Firebase Authentication) -->
            <include layout="@layout/view_google_sign_in" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
