<?xml version="1.0" encoding="utf-8"?>
<!-- Đang phát (xoay ngang): bên trái là sân khấu đĩa than + bao đĩa, bên phải là thông tin bài và điều khiển.
     Giữ nguyên các id như bản dọc để BaseActivity điều khiển phát nhạc như trước. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Ánh sáng màu bìa phía trên (màu đặt trong code) -->
    <View
        android:id="@+id/view_player_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="24dp">

        <!-- Cột trái: sân khấu, đĩa than nằm sau bao đĩa -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/frame_big_vinyl"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_disc_body_large"
                android:elevation="6dp">

                <View
                    android:id="@+id/view_player_vinyl_label"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/tv_player_vinyl_initial"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="M"
                    android:textColor="#E6FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_placeholder"
                    android:backgroundTint="#111113" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_player_sleeve"
                android:layout_width="204dp"
                android:layout_height="204dp"
                android:layout_gravity="center"
                android:elevation="14dp">

                <View
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-58dp"
                    android:layout_marginEnd="-66dp"
                    android:background="@drawable/bg_player_sleeve_ring" />

                <TextView
                    android:id="@+id/tv_player_sleeve_letter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-5dp"
                    android:layout_marginBottom="-48dp"
                    android:includeFontPadding="false"
                    android:text="M"
                    android:textColor="#2EFFFFFF"
                    android:textSize="175sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="15dp"
                    android:letterSpacing="0.22"
                    android:text="SIDE A · MELODYVERSE"
                    android:textColor="#B3FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_sleeve_title"
                    android:layout_width="136dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="16dp"
                    android:ellipsize="end"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="-2dp"
                    android:maxLines="3"
                    android:text="Tên bài hát"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_close_player"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:elevation="16dp"
                android:padding="10dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- Cột phải: thông tin bài + điều khiển (cuộn được trên máy màn hình thấp) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1.1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="ĐANG PHÁT"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="12dp"
                    android:text="MelodyVerse"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Thông tin bài -->
                <TextView
                    android:id="@+id/tv_dialog_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:text="50 Cuộc Gọi Nhỡ"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dialog_song_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tinh Hà"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_dialog_genre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tag_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="V-Pop"
                    android:textColor="@color/colorAccent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Thanh tua sóng âm -->
                <com.example.melodyverse.WaveformSeekBar
                    android:id="@+id/seekbar_dialog_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="0" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_dialog_time_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="00:00"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_dialog_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="00:00"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- Điều khiển: Trộn bài, Trước, Phát/Dừng, Sau, Lặp lại -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_dialog_shuffle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Trộn bài"
                        android:padding="11dp"
                        android:src="@drawable/ic_shuffle"
                        app:tint="@color/colorTextSecondary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btn_dialog_prev"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_player_soft_button"
                        android:contentDescription="Bài trước"
                        android:elevation="2dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_skip_previous"
                        app:tint="@color/colorTextPrimary" />

                    <ImageView
                        android:id="@+id/btn_dialog_play"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_play_button"
                        android:contentDescription="Phát / tạm dừng"
                        android:elevation="10dp"
                        android:padding="20dp"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/btn_dialog_next"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_player_soft_button"
                        android:contentDescription="Bài sau"
                        android:elevation="2dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_skip_next"
                        app:tint="@color/colorTextPrimary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btn_dialog_repeat"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Lặp lại"
                        android:padding="11dp"
                        android:src="@drawable/ic_repeat"
                        app:tint="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
