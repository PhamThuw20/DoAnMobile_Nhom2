<?xml version="1.0" encoding="utf-8"?>
<!-- Khám phá (màn hình ngang): Vòng xoay đĩa than bên trái, Tìm kiếm + Bảng xếp hạng cuộn riêng bên phải.
     Giữ nguyên toàn bộ id như bản dọc để DiscoverActivity dùng chung code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_screen_gradient"
    android:baselineAligned="false">

    <!-- Cột trái: Vòng xoay đĩa than (ẩn khi đang tìm kiếm, cột phải tự giãn ra) -->
    <LinearLayout
        android:id="@+id/layout_disc_wheel_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vòng xoay đĩa than"
            android:textColor="@color/colorTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_disc_wheel_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lướt để chọn đĩa, chạm Phát để nghe ngay"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <com.example.melodyverse.DiscWheelView
            android:id="@+id/rv_disc_wheel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="true" />
    </LinearLayout>

    <!-- Cột phải: Tìm kiếm, Top 1 và Bảng xếp hạng -->
    <com.example.melodyverse.DiscWheelScrollView
        android:id="@+id/scroll_discover"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Khám phá"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <ImageView
                    android:id="@+id/iv_discover_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_search"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:contentDescription="Tìm kiếm"
                    app:tint="@color/colorTextPrimary" />
            </LinearLayout>

            <!-- In-Place Search Bar for Discover (Ẩn mặc định, nhấn kính lúp để mở) -->
            <LinearLayout
                android:id="@+id/layout_discover_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">

                    <EditText
                        android:id="@+id/et_discover_search"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Tìm bài hát, nghệ sĩ"
                        android:textColorHint="@color/colorInputHint"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="40dp"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/colorTextMuted"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/iv_clear_discover_search"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_close"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/colorTextSecondary"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_discover_search_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Kết quả tìm kiếm (riêng biệt với Bảng xếp hạng và Vòng xoay đĩa than) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_discover_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Top #1 Trending Hero Banner (thấp hơn bản dọc cho vừa chiều cao màn hình ngang) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_top1_banner"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:background="@drawable/bg_featured_banner"
                android:elevation="4dp"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <!-- Trophy Badge -->
                <LinearLayout
                    android:id="@+id/layout_badge_top1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_trophy"
                        app:tint="#FDE68A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Được yêu thích nhất"
                        android:textColor="#FDE68A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_banner_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="50 Cuộc Gọi Nhỡ"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@id/layout_badge_top1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_banner_play" />

                <TextView
                    android:id="@+id/tv_banner_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Tinh Hà · 24,5K lượt yêu thích"
                    android:textColor="#E9D5FF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_banner_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_banner_play" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Bài hát được cộng đồng thả tim nhiều nhất"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_banner_play" />

                <!-- Play Button -->
                <ImageView
                    android:id="@+id/btn_banner_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/white"
                    android:padding="13dp"
                    android:contentDescription="Phát"
                    app:tint="@color/colorAccent"
                    android:elevation="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Section: Bảng xếp hạng (tự sắp xếp theo tổng lượt thả tim của từng bài hát) -->
            <LinearLayout
                android:id="@+id/layout_chart_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bảng xếp hạng thịnh hành"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theo lượt thả tim"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Các hàng bài hát (TrackListAdapter) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_discover_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_discover_chart_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có bài hát nào trên bảng xếp hạng. Hãy thả tim cho bài hát bạn yêu thích!"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone" />

            <!-- Empty State for Discover Search -->
            <LinearLayout
                android:id="@+id/layout_discover_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/colorTextMuted"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_discover_search_empty_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không tìm thấy kết quả"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thử tìm theo tên bài hát hoặc nghệ sĩ khác."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="14dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_reset_discover_search"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Xóa tìm kiếm"
                    android:textAllCaps="false"
                    android:textColor="@color/colorAccent"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_button_tonal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>

        </LinearLayout>
    </com.example.melodyverse.DiscWheelScrollView>
</LinearLayout>
