<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng tin - giao diện NGANG.
     Chiều cao màn hình ngang rất thấp nên tách 2 cột:
     - Cột trái (cố định 220dp): logo + nút tìm kiếm, thanh tìm kiếm, tiêu đề bảng tin, chip thể loại (xếp dọc)
     - Cột phải: toàn bộ chiều cao dành cho danh sách bài viết (vuốt làm mới + tải thêm)
     Giữ nguyên toàn bộ id + loại view mà MainActivity dùng (findViewById chạy được ở cả 2 chiều).
     Lưu ý: chip thể loại nằm trong ScrollView dọc với id khác (scroll_genres_land),
     KHÔNG dùng lại id scroll_genres vì HorizontalScrollView/ScrollView lưu trạng thái khác loại. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- ===== Cột trái: header + bộ lọc ===== -->
    <LinearLayout
        android:id="@+id/layout_feed_side_panel"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Top App Bar (thu gọn) -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ic_logo_melodyverse" />

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MelodyVerse"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:letterSpacing="-0.02" />

            <!-- Nút Kính lúp Tìm kiếm -->
            <FrameLayout
                android:id="@+id/btn_header_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    app:tint="@color/colorTextPrimary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Thanh tìm kiếm mở rộng (Ẩn mặc định, nhấn kính lúp để mở) -->
        <LinearLayout
            android:id="@+id/layout_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_search_pill"
                    android:hint="#hashtag, người đăng..."
                    android:textColorHint="@color/colorInputHint"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="36dp"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/colorTextMuted"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/iv_clear_search"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_close"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/colorTextSecondary"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tiêu đề + chip thể loại: cuộn dọc khi màn hình quá thấp (có mini player) -->
        <ScrollView
            android:id="@+id/scroll_genres_land"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- Feed Header Title -->
                <TextView
                    android:id="@+id/tv_feed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bảng tin âm nhạc"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp" />

                <!-- Thông báo số lượng kết quả tìm kiếm -->
                <TextView
                    android:id="@+id/tv_search_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Tìm thấy 2 bài viết &amp; ca khúc"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Thể loại"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <!-- Genre & Mood Filter Pills (xếp dọc ở màn hình ngang) -->
                <TextView
                    android:id="@+id/chip_genre_all"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Tất cả"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/chip_genre_vpop"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="V-Pop"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/chip_genre_rap"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Rap / Hip-hop"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/chip_genre_chill"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Indie &amp; Chill"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/chip_genre_rnb"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="R&amp;B"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Đường kẻ dọc ngăn 2 cột -->
    <View
        android:id="@+id/view_feed_side_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/colorLine"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_feed_side_panel" />

    <!-- ===== Cột phải: bảng tin ===== -->
    <!-- Vuốt xuống để làm mới bảng tin (đồng bộ Firebase -> SQLite) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_main"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_feed_side_divider"
        app:layout_constraintEnd_toEndOf="parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Feed RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Trạng thái cuối danh sách: đang tải thêm / đã hết / đang xem dữ liệu offline -->
            <TextView
                android:id="@+id/tv_feed_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Empty Search State khi không tìm thấy kết quả -->
            <LinearLayout
                android:id="@+id/layout_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icon_tonal"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_search"
                        android:layout_gravity="center"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_search_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không tìm thấy kết quả"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_search_empty_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thử tìm theo tên bài hát, nghệ sĩ hoặc thể loại khác."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_reset_search"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:text="Xem tất cả bài viết"
                    android:textAllCaps="false"
                    android:textColor="@color/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_tonal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
