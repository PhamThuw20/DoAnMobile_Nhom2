<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_admin_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <ImageView
        android:id="@+id/iv_admin_user_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:src="@drawable/ic_person"
        android:padding="9dp"
        app:tint="@color/colorTextMuted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_admin_user_fullname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phạm Minh Thư"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_admin_user_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\@minhthu"
            android:textColor="@color/colorTextMuted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_admin_user_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang hoạt động"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_admin_toggle_lock"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="80dp"
        android:text="Khóa"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="center"
        android:background="@drawable/bg_admin_btn_red"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</LinearLayout>
