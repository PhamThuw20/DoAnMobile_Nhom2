<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại Quên mật khẩu (cùng kiểu với hộp thoại Đăng xuất): nhập username hoặc email để nhận link đặt lại mật khẩu (Firebase Authentication) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_logout"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_icon_tonal">

        <ImageView
            android:id="@+id/iv_forgot_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/colorAccent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_forgot_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Quên mật khẩu?"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_forgot_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Nhập tên đăng nhập hoặc email đã đăng ký. Chúng tôi sẽ gửi link đặt lại mật khẩu tới email của tài khoản."
        android:textColor="@color/colorTextSecondary"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/et_forgot_identifier"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_login_input"
        android:drawableStart="@drawable/ic_mail"
        android:drawablePadding="12dp"
        android:drawableTint="@color/colorTextMuted"
        android:hint="Tên đăng nhập hoặc email"
        android:imeOptions="actionSend"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorInputHint"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/layout_forgot_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_forgot_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_forgot_send"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gradient_button"
            android:text="Gửi email"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
