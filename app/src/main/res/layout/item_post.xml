<?xml version="1.0" encoding="utf-8"?>
<!-- Post Card (redesign): bố cục cột avatar + nội dung, ngăn bài bằng đường kẻ mảnh.
     Giữ nguyên toàn bộ id và loại view để PostAdapter hoạt động như cũ. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="14dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/iv_post_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_avatar_circle"
        android:padding="8dp"
        android:src="@drawable/ic_person"
        app:tint="@color/colorAccent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tên, username, thời gian, quyền riêng tư -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/iv_post_avatar"
        app:layout_constraintEnd_toStartOf="@id/iv_post_more"
        app:layout_constraintStart_toEndOf="@id/iv_post_avatar"
        app:layout_constraintTop_toTopOf="@id/iv_post_avatar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_post_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Ngọc Thành"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_post_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=" • @ngocthanh"
                android:textColor="@color/colorTextMuted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 giờ trước"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ·  "
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/iv_post_privacy_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_public"
                app:tint="@color/colorTextMuted" />

            <TextView
                android:id="@+id/tv_post_privacy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Công khai"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_post_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Tùy chọn"
        android:padding="8dp"
        android:src="@drawable/ic_more"
        app:tint="@color/colorTextMuted"
        app:layout_constraintBottom_toBottomOf="@id/iv_post_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_post_avatar" />

    <!-- Nội dung bài viết: thụt vào thẳng hàng với tên -->
    <TextView
        android:id="@+id/tv_post_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:lineSpacingExtra="3dp"
        android:text="Chill cùng Tinh Hà nào. Bài này nghe lúc nửa đêm là hết ý."
        android:textColor="@color/colorTextPrimary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_post_avatar"
        app:layout_constraintTop_toBottomOf="@id/iv_post_avatar" />

    <!-- Khối nhạc (Audio Player trong bài viết) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_music_card"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_music_card"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_post_avatar"
        app:layout_constraintTop_toBottomOf="@id/tv_post_caption">

        <!-- Ảnh bìa dạng đĩa than tròn: thân đĩa có rãnh + nhãn đĩa màu theo bài + lỗ tâm.
             Kích thước cố định 48dp (tỷ lệ 1:1) nên luôn tròn đều, không méo trên mọi màn hình;
             khi bài đang phát, cả đĩa quay quanh tâm. -->
        <FrameLayout
            android:id="@+id/frame_music_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_vinyl_disc_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Nhãn đĩa: màu theo từng bài (PostAdapter tô bằng DiscPalette) -->
            <View
                android:id="@+id/view_music_art_label"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_vinyl_spindle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_eq_wave"
            app:layout_constraintStart_toEndOf="@id/frame_music_art"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_music_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="50 Cuộc Gọi Nhỡ"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_music_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tinh Hà"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Equalizer: chỉ hiện khi bài đang phát (code bật/tắt) -->
        <LinearLayout
            android:id="@+id/layout_eq_wave"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_music_play"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/eq_bar_1"
                android:layout_width="3dp"
                android:layout_height="8dp"
                android:layout_marginEnd="2.5dp"
                android:background="@drawable/bg_eq_bar" />

            <View
                android:id="@+id/eq_bar_2"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_marginEnd="2.5dp"
                android:background="@drawable/bg_eq_bar" />

            <View
                android:id="@+id/eq_bar_3"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="2.5dp"
                android:background="@drawable/bg_eq_bar" />

            <View
                android:id="@+id/eq_bar_4"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_eq_bar" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_music_play"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_play_button_light"
            android:contentDescription="Phát / tạm dừng"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            app:tint="@color/colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Thể loại + hashtag -->
    <LinearLayout
        android:id="@+id/layout_hashtags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_post_avatar"
        app:layout_constraintTop_toBottomOf="@id/layout_music_card">

        <TextView
            android:id="@+id/tv_genre_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="V-POP"
            android:textColor="@color/colorAccent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_hashtag1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="#TinhHa"
            android:textColor="@color/colorAccent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_hashtag2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="#NhacViet"
            android:textColor="@color/colorAccent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Thích / Bình luận / Chia sẻ / Lưu -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_post_avatar"
        app:layout_constraintTop_toBottomOf="@id/layout_hashtags">

        <LinearLayout
            android:id="@+id/btn_like_container"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:minWidth="64dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iv_post_like"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="248"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_comment_container"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:minWidth="64dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iv_post_comment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_comment"
                app:tint="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/tv_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="32"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_share_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iv_post_share"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_share"
                app:tint="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/tv_share_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="12"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_post_bookmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lưu bài viết"
            android:padding="10dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/colorTextSecondary" />
    </LinearLayout>

    <!-- Đường kẻ ngăn giữa các bài viết -->
    <View
        android:id="@+id/view_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/colorLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_actions" />

</androidx.constraintlayout.widget.ConstraintLayout>
