<?xml version="1.0" encoding="utf-8"?>
<!-- Đang phát (toàn màn hình). Bao đĩa mang màu riêng của bài; khi phát, đĩa than trượt ra khỏi bao và quay.
     Giữ nguyên các id cũ để BaseActivity điều khiển phát nhạc như trước. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Ánh sáng màu bìa phía trên (màu đặt trong code) -->
    <View
        android:id="@+id/view_player_glow"
        android:layout_width="match_parent"
        android:layout_height="460dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Thanh trên -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/btn_close_player"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:padding="10dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/colorTextPrimary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="ĐANG PHÁT"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="MelodyVerse"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Sân khấu: đĩa than nằm sau bao đĩa -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/frame_big_vinyl"
                android:layout_width="228dp"
                android:layout_height="228dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_disc_body_large"
                android:elevation="6dp">

                <View
                    android:id="@+id/view_player_vinyl_label"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/tv_player_vinyl_initial"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="M"
                    android:textColor="#E6FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_placeholder"
                    android:backgroundTint="#111113" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_player_sleeve"
                android:layout_width="244dp"
                android:layout_height="244dp"
                android:layout_gravity="center"
                android:elevation="14dp">

                <View
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-80dp"
                    android:background="@drawable/bg_player_sleeve_ring" />

                <TextView
                    android:id="@+id/tv_player_sleeve_letter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-6dp"
                    android:layout_marginBottom="-58dp"
                    android:includeFontPadding="false"
                    android:text="M"
                    android:textColor="#2EFFFFFF"
                    android:textSize="210sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.22"
                    android:text="SIDE A · MELODYVERSE"
                    android:textColor="#B3FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_sleeve_title"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="20dp"
                    android:ellipsize="end"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="-2dp"
                    android:maxLines="3"
                    android:text="Tên bài hát"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <!-- Thông tin bài -->
        <TextView
            android:id="@+id/tv_dialog_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="50 Cuộc Gọi Nhỡ"
            android:textColor="@color/colorTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_song_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tinh Hà"
            android:textColor="@color/colorTextSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_dialog_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="V-Pop"
            android:textColor="@color/colorAccent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Thanh tua sóng âm -->
        <com.example.melodyverse.WaveformSeekBar
            android:id="@+id/seekbar_dialog_timeline"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="22dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progress="0" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:id="@+id/tv_dialog_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00:00"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_dialog_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="00:00"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Điều khiển: Trộn bài, Trước, Phát/Dừng, Sau, Lặp lại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_dialog_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Trộn bài"
                android:padding="11dp"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/colorTextSecondary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_dialog_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_soft_button"
                android:contentDescription="Bài trước"
                android:elevation="2dp"
                android:padding="15dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/colorTextPrimary" />

            <ImageView
                android:id="@+id/btn_dialog_play"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="Phát / tạm dừng"
                android:elevation="10dp"
                android:padding="24dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btn_dialog_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_soft_button"
                android:contentDescription="Bài sau"
                android:elevation="2dp"
                android:padding="15dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/colorTextPrimary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_dialog_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lặp lại"
                android:padding="11dp"
                android:src="@drawable/ic_repeat"
                app:tint="@color/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
