<?xml version="1.0" encoding="utf-8"?>
<!-- Vuốt xuống để tải lại hồ sơ từ Firebase -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Cover Gradient Banner -->
        <View
            android:id="@+id/view_cover_banner"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_profile_cover"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Back button on header for navigating from followers or details -->
        <ImageView
            android:id="@+id/iv_profile_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="14dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_tonal"
            android:backgroundTint="#33FFFFFF"
            android:padding="9dp"
            app:tint="@color/white"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Settings icon on header -->
        <ImageView
            android:id="@+id/iv_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="14dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Cài đặt"
            android:background="@drawable/bg_icon_tonal"
            android:backgroundTint="#33FFFFFF"
            android:padding="9dp"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Avatar with glowing ring -->
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_story_ring"
            app:layout_constraintTop_toBottomOf="@id/view_cover_banner"
            app:layout_constraintBottom_toBottomOf="@id/view_cover_banner"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:padding="22dp"
                app:tint="@color/colorAccent" />
        </FrameLayout>

        <!-- User Names -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phạm Minh Thư"
            android:textColor="@color/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_container"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@minhthu_music"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- User Bio -->
        <TextView
            android:id="@+id/tv_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nghe nhạc mỗi ngày, chia sẻ những bài làm mình thấy bình yên."
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_username" />

        <!-- Statistics Card (Posts, Followers, Following) -->
        <LinearLayout
            android:id="@+id/layout_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_gradient"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_bio">

            <!-- Stat 1: Bài viết -->
            <LinearLayout
                android:id="@+id/btn_stat_posts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_stat_posts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài viết"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/colorLine" />

            <!-- Stat 2: Người theo dõi -->
            <LinearLayout
                android:id="@+id/btn_stat_followers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_stat_followers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Người theo dõi"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/colorLine" />

            <!-- Stat 3: Đang theo dõi -->
            <LinearLayout
                android:id="@+id/btn_stat_following"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tv_stat_following"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang theo dõi"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Profile Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_profile_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/layout_stats">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_edit_profile"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Chỉnh sửa hồ sơ"
                android:textAllCaps="false"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_button_secondary"
                android:drawableStart="@drawable/ic_edit"
                android:drawablePadding="8dp"
                android:drawableTint="@color/colorTextSecondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:textColor="@color/colorDanger"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_button_danger_soft"
                android:drawableStart="@drawable/ic_logout"
                android:drawablePadding="8dp"
                android:drawableTint="@color/colorDanger"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- Music Activity Header & Tabs (Bài đã chia sẻ, Bài đã thích, Danh sách nhạc đã lưu) -->
        <HorizontalScrollView
            android:id="@+id/layout_profile_tabs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@id/layout_profile_buttons">

            <LinearLayout
                android:id="@+id/layout_profile_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_profile_my_posts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài đã chia sẻ (1)"
                    android:textColor="@color/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tab_profile_liked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài đã thích (0)"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tab_profile_saved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách nhạc đã lưu (0)"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Dynamic RecyclerView for User Posts / Saved Posts -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_profile_posts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/layout_profile_tabs_scroll"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Danh sách nhạc đã lưu: các bản nhạc dạng gọn, bấm để nghe hoặc phát toàn bộ -->
        <LinearLayout
            android:id="@+id/layout_profile_saved_tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_profile_tabs_scroll">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_saved_tracks_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 bài hát"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_saved_play_all"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="Phát tất cả"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_gradient_button"
                    android:drawableStart="@drawable/ic_play"
                    android:drawableTint="@color/white"
                    android:drawablePadding="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_profile_saved_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- Empty State for Profile Posts -->
        <TextView
            android:id="@+id/tv_profile_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có bài viết nào ở đây."
            android:textColor="@color/colorTextMuted"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layout_profile_tabs_scroll"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
