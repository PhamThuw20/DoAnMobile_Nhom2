<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <!-- Avatar with glowing border -->
    <ImageView
        android:id="@+id/iv_follow_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar_circle"
        android:src="@drawable/ic_person"
        android:padding="8dp"
        app:tint="@color/colorAccent" />

    <!-- User Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_follow_fullname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quang Hùng MasterD"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_follow_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@quanghung_masterd"
            android:textColor="@color/colorTextMuted"
            android:textSize="13sp"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/tv_follow_bio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nghệ sĩ V-Pop"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Follow / Unfollow Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_follow_action"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Đang theo dõi"
        android:textAllCaps="false"
        android:minWidth="0dp"
        android:textColor="@color/colorTextPrimary"
        android:textStyle="bold"
        android:textSize="13sp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

</LinearLayout>
