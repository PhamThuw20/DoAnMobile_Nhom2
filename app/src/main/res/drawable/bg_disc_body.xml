<?xml version="1.0" encoding="utf-8"?>
<!-- Thân đĩa than cho vòng xoay Khám phá: mặt đen bóng, rãnh đĩa và vệt sáng (thấy rõ khi đĩa xoay) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#121214" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <stroke android:width="0.8dp" android:color="#2A2A30" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <stroke android:width="0.8dp" android:color="#34343C" />
        </shape>
    </item>
    <item android:top="15dp" android:bottom="15dp" android:left="15dp" android:right="15dp">
        <shape android:shape="oval">
            <stroke android:width="0.8dp" android:color="#2A2A30" />
        </shape>
    </item>
    <!-- Vệt sáng quét theo vòng: khi đĩa xoay, vệt sáng chạy theo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#00FFFFFF"
                android:centerColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
