<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Vinyl Body (Glossy Obsidian Record) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#121214" />
        </shape>
    </item>
    <!-- Vinyl Groove Ring 1 -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <stroke android:width="0.8dp" android:color="#27272A" />
        </shape>
    </item>
    <!-- Vinyl Groove Ring 2 -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <stroke android:width="0.8dp" android:color="#3F3F46" />
        </shape>
    </item>
    <!-- Vinyl Groove Ring 3 -->
    <item android:top="30dp" android:bottom="30dp" android:left="30dp" android:right="30dp">
        <shape android:shape="oval">
            <stroke android:width="0.8dp" android:color="#27272A" />
        </shape>
    </item>
    <!-- Center Label (Vibrant Gradient Core) -->
    <item android:top="42dp" android:bottom="42dp" android:left="42dp" android:right="42dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#8B5CF6"
                android:endColor="#EC4899"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#F43F5E" />
        </shape>
    </item>
    <!-- Center Spindle Hole -->
    <item android:top="72dp" android:bottom="72dp" android:left="72dp" android:right="72dp">
        <shape android:shape="oval">
            <solid android:color="#0F0F12" />
            <stroke android:width="1dp" android:color="#E2E8F0" />
        </shape>
    </item>
</layer-list>
