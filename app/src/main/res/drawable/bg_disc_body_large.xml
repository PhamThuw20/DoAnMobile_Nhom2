<?xml version="1.0" encoding="utf-8"?>
<!-- Đĩa than lớn của màn Đang phát: mặt đen bóng, nhiều rãnh và vệt sáng quét theo khi đĩa quay -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#111113" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#26262C" /></shape>
    </item>
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#2F2F37" /></shape>
    </item>
    <item android:top="24dp" android:bottom="24dp" android:left="24dp" android:right="24dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#26262C" /></shape>
    </item>
    <item android:top="32dp" android:bottom="32dp" android:left="32dp" android:right="32dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#33333B" /></shape>
    </item>
    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#26262C" /></shape>
    </item>
    <item android:top="48dp" android:bottom="48dp" android:left="48dp" android:right="48dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#2F2F37" /></shape>
    </item>
    <item android:top="56dp" android:bottom="56dp" android:left="56dp" android:right="56dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#26262C" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#00FFFFFF"
                android:centerColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
